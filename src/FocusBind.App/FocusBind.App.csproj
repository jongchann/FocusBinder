<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FocusBind.Core\FocusBind.Core.csproj" />
    <ProjectReference Include="..\FocusBind.Win32\FocusBind.Win32.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Version>0.1.0-preview.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>FocusBind</Product>
    <Description>Window-specific input mapping and shortcut overlays for Windows.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FocusBind.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup><Resource Include="Assets\FocusBind.ico"/><Resource Include="Assets\FocusBind.png"/></ItemGroup>

</Project>
