<Window x:Class="FocusBind.App.BindingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusBind.App"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="FocusBind — 키 바인딩" Width="1360" Height="820" MinWidth="1080" MinHeight="650" ResizeMode="CanResize"
        Background="#FFF6F8FB" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <local:TriggerLabelConverter x:Key="TriggerLabelConverter"/>
        <Style x:Key="MarkerStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <Ellipse Stroke="Black" StrokeThickness="3" Margin="2"/>
                            <Ellipse Stroke="{TemplateBinding Background}" StrokeThickness="1.5" Margin="2"/>
                            <Path Data="M 9,0 L 9,6 M 9,12 L 9,18 M 0,9 L 6,9 M 12,9 L 18,9" Stroke="White" StrokeThickness="1"/>
                            <Ellipse Width="3" Height="3" Fill="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#FF182436" Padding="20,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="변경사항 저장" Width="125" Margin="12,0,0,0" Click="Save_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="최소화" Click="Minimize_Click" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="키 바인딩 작업실" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TargetText" Foreground="#FFB8C7D6" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#FFE0E6EE" BorderThickness="0,0,1,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="145"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="01   프로필" Style="{StaticResource SectionTitle}"/>
                    <ListBox x:Name="ProfilesList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="ProfilesList_SelectionChanged"/>
                    <WrapPanel Grid.Row="2" Margin="0,6,0,12">
                        <Button Content="추가" Padding="8,3" Click="AddProfile_Click"/>
                        <Button Content="복제" Padding="8,3" Margin="4,0,0,0" Click="DuplicateProfile_Click"/>
                        <Button Content="삭제" Padding="8,3" Margin="4,0,0,0" Click="DeleteProfile_Click"/>
                        <Button Content="창 조건" Padding="8,3" Margin="4,0,0,0" Click="ProfileSettings_Click"/>
                        <Button Content="레이아웃" Padding="8,3" Margin="4,6,0,0" Click="LayoutSettings_Click"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="3" Text="02   매핑" Style="{StaticResource SectionTitle}"/>
                    <ListBox x:Name="MappingsList" Grid.Row="4" SelectionChanged="MappingsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Trigger, Converter={StaticResource TriggerLabelConverter}}" FontSize="10" Foreground="#FF637589" TextWrapping="Wrap" MaxWidth="180"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="5" Margin="0,6,0,0">
                        <Button Content="매핑 추가" Padding="8,3" Click="AddMapping_Click"/>
                        <Button Content="삭제" Padding="8,3" Margin="4,0,0,0" Click="DeleteMapping_Click"/>
                        <Button Content="↑" ToolTip="매핑 위로" Padding="7,3" Margin="4,0,0,0" Click="MoveMappingUp_Click"/>
                        <Button Content="↓" ToolTip="매핑 아래로" Padding="7,3" Margin="4,0,0,0" Click="MoveMappingDown_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,9">
                    <Button x:Name="RefreshPreviewButton" DockPanel.Dock="Right" Content="화면 새로 캡처" Padding="8,4" Click="RefreshPreview_Click"/>
                    <TextBlock Text="클릭 위치 배치" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Grid.Row="1" Background="#FF182436" CornerRadius="10" Padding="6">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="PreviewSurface" Width="640" Height="360" Background="#FF24364A">
                            <Image x:Name="TargetPreviewImage" Stretch="Fill" IsHitTestVisible="False"/>
                            <Canvas IsHitTestVisible="False" Opacity="0.25">
                                <Line x:Name="GridLineX1" Stroke="White"/>
                                <Line x:Name="GridLineX2" Stroke="White"/>
                                <Line x:Name="GridLineY1" Stroke="White"/>
                                <Line x:Name="GridLineY2" Stroke="White"/>
                            </Canvas>
                            <TextBlock x:Name="PreviewPlaceholder" Text="화면 새로 캡처를 눌러 대상 창을 표시하세요." TextWrapping="Wrap" Foreground="#FF8FA4B8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Canvas x:Name="MarkerCanvas" ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="MarkerCanvas_MouseLeftButtonDown"/>
                        </Grid>
                    </Viewbox>
                </Border>
                <TextBlock Grid.Row="2" Margin="0,9,0,0" Foreground="#FF526579" TextWrapping="Wrap"
                           Text="캡처 화면을 클릭하거나 작은 십자 마커를 드래그하세요. 십자 중심이 실제 클릭 지점입니다. 화면은 새로 캡처할 때 갱신됩니다."/>
            </Grid>
            <Border Grid.Column="2" Background="White" BorderBrush="#FFE0E6EE" BorderThickness="1,0,0,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="03   매핑 속성" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    <TextBlock Text="이름"/>
                    <TextBox x:Name="MappingNameBox" Margin="0,4,0,14" LostFocus="MappingNameBox_LostFocus"/>
                    <CheckBox x:Name="MappingEnabledBox" Content="이 매핑 사용" Margin="0,0,0,10" Checked="MappingEnabled_Changed" Unchecked="MappingEnabled_Changed"/>
                    <TextBlock x:Name="MappingStatusText" TextWrapping="Wrap" Foreground="#FFB03D38" Margin="0,0,0,10"/>
                    <TextBlock Text="트리거" FontWeight="SemiBold"/>
                    <ComboBox x:Name="TriggerTypeCombo" Margin="0,4,0,8" SelectionChanged="TriggerTypeCombo_SelectionChanged">
                        <ComboBoxItem Content="키보드 키"/>
                        <ComboBoxItem Content="마우스 왼쪽"/>
                        <ComboBoxItem Content="마우스 오른쪽"/>
                        <ComboBoxItem Content="마우스 가운데"/>
                        <ComboBoxItem Content="마우스 X1"/>
                        <ComboBoxItem Content="마우스 X2"/>
                        <ComboBoxItem Content="휠 위"/>
                        <ComboBoxItem Content="휠 아래"/>
                        <ComboBoxItem Content="휠 오른쪽"/>
                        <ComboBoxItem Content="휠 왼쪽"/>
                    </ComboBox>
                    <Button x:Name="RecordTriggerButton" Content="다음 입력 기록" Padding="8,4" Margin="0,0,0,8"
                            Click="RecordTriggerButton_Click"/>
                    <StackPanel x:Name="KeyCapturePanel">
                        <TextBox x:Name="KeyBox" Margin="0,0,0,5" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                        <TextBlock Text="Ctrl·Alt·Shift·Win을 누른 채 키를 입력하면 조합키로 등록됩니다." Foreground="#FF637589" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="트리거 단계" Margin="0,10,0,4"/>
                    <ComboBox x:Name="TriggerPhaseCombo" SelectionChanged="TriggerPhaseCombo_SelectionChanged">
                        <ComboBoxItem Content="누름"/>
                        <ComboBoxItem Content="뗌"/>
                        <ComboBoxItem Content="길게 누름"/>
                    </ComboBox>
                    <StackPanel x:Name="LongPressSettings" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="길게 누름 시간 (50~60000 밀리초)"/>
                        <TextBox x:Name="LongPressMillisecondsBox" Text="500" Margin="0,4,0,0"
                                 LostFocus="LongPressMillisecondsBox_LostFocus"/>
                    </StackPanel>
                    <TextBlock Text="휠은 누름 단계만 지원합니다." FontSize="11" Foreground="#FF637589" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ConflictText" Foreground="#FFB03D38" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    <CheckBox x:Name="ConsumeBox" Content="원본 입력 차단" Margin="0,18,0,0"
                              Checked="ConsumeBox_Changed" Unchecked="ConsumeBox_Changed"/>
                    <Border Height="1" Background="#FFE0E6EE" Margin="0,22,0,22"/>
                    <TextBlock Text="액션" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ActionModeCombo" Margin="0,8,0,8" SelectionChanged="ActionModeCombo_SelectionChanged">
                        <ComboBoxItem Content="한 번 클릭"/>
                        <ComboBoxItem Content="반복 클릭"/>
                        <ComboBoxItem Content="마우스 휠"/>
                        <ComboBoxItem Content="사용자 시퀀스"/>
                    </ComboBox>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="액션 목록 편집" Padding="8,4" Click="EditActions_Click" Margin="0,0,6,6"/>
                        <Button Content="입력 없이 테스트" Padding="8,4" Click="DryRun_Click" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="기본 액션을 고르면 현재 액션 목록을 교체합니다. 여러 액션은 목록 편집을 사용하세요." FontSize="11" Foreground="#FF637589" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel x:Name="WheelSettings" Visibility="Collapsed">
                        <TextBlock Text="스크롤 방향"/>
                        <ComboBox x:Name="WheelDirectionCombo" Margin="0,4,0,10" SelectionChanged="WheelDirectionCombo_SelectionChanged">
                            <ComboBoxItem Content="위"/>
                            <ComboBoxItem Content="아래"/>
                            <ComboBoxItem Content="오른쪽"/>
                            <ComboBoxItem Content="왼쪽"/>
                        </ComboBox>
                        <TextBlock Text="스크롤 양 (1~12000, 한 칸 = 120)" TextWrapping="Wrap"/>
                        <TextBox x:Name="WheelAmountBox" Text="120" Margin="0,4,0,8" LostFocus="WheelAmountBox_LostFocus"/>
                        <TextBlock Text="현재 커서 위치에서 휠을 보냅니다. 대상 창 위에 커서를 두세요. 확대·축소 동작은 대상 앱의 휠 설정에 따릅니다."
                                   Foreground="#FF637589" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="RepeatSettings" Visibility="Collapsed">
                        <TextBlock Text="반복 횟수 (1~1000)"/>
                        <TextBox x:Name="RepeatCountBox" Text="5" Margin="0,4,0,10" LostFocus="RepeatSettings_LostFocus"/>
                        <TextBlock Text="간격 (밀리초)"/>
                        <TextBox x:Name="RepeatIntervalBox" Text="100" Margin="0,4,0,10" LostFocus="RepeatSettings_LostFocus"/>
                    </StackPanel>
                    <StackPanel x:Name="CoordinateSettings">
                    <Border Height="1" Background="#FFE0E6EE" Margin="0,20,0,20"/>
                    <TextBlock Text="클릭 위치" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CoordinateText" Foreground="#FF526579" Margin="0,6,0,0"/>
                    <Button Content="화면에서 지점 선택" Padding="8,5" Margin="0,11,0,0" Click="CaptureCoordinate_Click"/>
                    <TextBlock Text="좌표 클릭 방식" Margin="0,11,0,4"/>
                    <ComboBox x:Name="ClickModeCombo" SelectionChanged="ClickModeCombo_SelectionChanged">
                        <ComboBoxItem Content="커서 이동 (게임 호환성 우선)"/>
                        <ComboBoxItem Content="창 메시지 (커서 고정, 일부 게임 미지원)"/>
                        <ComboBoxItem Content="빠른 이동·클릭·복원 (기존 매니저 방식)"/>
                    </ComboBox>
                    <TextBlock Text="빠른 방식은 즉시 누르고 뗀 뒤 약 20ms 후 복원합니다. 게임에서 클릭이 누락되면 기본 커서 이동 방식과 비교하세요."
                               FontSize="11" Foreground="#FF637589" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ClickModeWarning" Visibility="Collapsed" Foreground="#FFB03D38"
                               Text="이 게임 창은 실제 커서 위치에서 클릭됩니다. 창 메시지 방식은 실행 시 차단됩니다. 커서 이동 방식을 선택하세요."
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <CheckBox x:Name="RestoreCursorBox" Content="클릭 후 커서 원위치" Margin="0,11,0,0"
                              Checked="RestoreCursorBox_Changed" Unchecked="RestoreCursorBox_Changed"/>
                    <TextBlock Text="창 크기가 바뀌면 좌표를 다시 계산합니다." Foreground="#FF637589"
                               Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#FFE8EDF3" Padding="15,8">
            <TextBlock x:Name="StatusText" Text="프로필을 선택하세요." Foreground="#FF30455B" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
